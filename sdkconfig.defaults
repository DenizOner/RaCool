# Basic ESP-IDF configurations
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
# Require explicit app health confirmation before bootloader accepts an OTA image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Disable component registry to avoid network issues - REMOVED to allow dependency resolution
# CONFIG_IDF_COMPONENT_REGISTRY_URL=""
CONFIG_IDF_COMPONENT_OVERWRITE_MANAGED_COMPONENTS=1
CONFIG_ESP_ENCRYPTED_IMG=n

# Zigbee router configuration (Zigbee2MQTT compatible)
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_ZED=n
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_NWK_KEY_ROTATION=y
CONFIG_ZB_APS_FRAGMENTATION=y

# LittleFS configuration defaults
CONFIG_LITTLEFS_BLOCK_SIZE=4096
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_CACHE_SIZE=512
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_MAX_PARTITIONS=3

# Console selection is defined below for native USB Serial/JTAG.

# FreeRTOS Diagnostic & Trace configurations
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Global compiler settings
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# mbedTLS
CONFIG_MBEDTLS_ENTROPY_C=y
CONFIG_MBEDTLS_ENTROPY_HARDWARE_ALT=y
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CIPHER_C=y

# Main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Dynamic frequency scaling; router automatic light sleep remains disabled.
CONFIG_PM_ENABLE=y
# ESP-IDF MAC retention lifecycle requires the matching tickless capability.
# PowerManager still sets light_sleep_enable=false for the Zigbee router.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Native USB Serial/JTAG is the bidirectional development console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
